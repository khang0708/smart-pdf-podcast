# ==============================================================================
# BIẾN MÔI TRƯỜNG SAAS CHO AURORA READER
# Quản trị viên cấu hình file này (hoặc khai báo trên Vercel / Netlify / Cloudflare Pages)
# Khách hàng cuối (End-users) hoàn toàn không thấy và không cần cấu hình những thông tin này.
# ==============================================================================

# 1. Cloudflare Edge Server (Khuyên dùng số 1 cho SaaS - Phản hồi < 20ms, 0s Cold-start, $0 Egress Fee)
# URL của Worker sau khi chạy `npx wrangler deploy` trong thư mục /worker
VITE_CLOUDFLARE_WORKER_URL=https://aurora-reader-api.your-subdomain.workers.dev

# 2. Supabase Central Database & Storage (Phương án dự phòng)
# Lấy từ Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 2. Google Cloud Platform (Tùy chọn - Dành cho tính năng đăng nhập Google hoặc Google Drive Picker)
# Nếu không cấu hình, người dùng vẫn nhập file bình thường qua liên kết công khai hoặc Tệp máy
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# 3. Cấu hình giới hạn gói cước SaaS (Mặc định)
VITE_DEFAULT_FREE_STORAGE_MB=50
VITE_DEFAULT_PRO_STORAGE_MB=5120
